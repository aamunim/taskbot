# Set these with:  supabase secrets set --env-file supabase/functions/.env
# Never commit the real file.
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Any long random string (e.g. `openssl rand -hex 32`). Protects setup/cron endpoints.
ADMIN_SECRET=
# Optional: restrict ownership to one Telegram user id. If empty, the first
# person who logs in through the bot becomes the owner.
OWNER_TELEGRAM_ID=
# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# ELEVENLABS_STT_MODEL=scribe_v1
