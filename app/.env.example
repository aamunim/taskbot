# Copy to .env and fill in (Supabase dashboard -> Project Settings -> API).
# The anon key is safe to ship in the app; never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Design preview only: set to 1 to run with built-in sample data and no server.
# Leave unset for real builds.
# EXPO_PUBLIC_DEMO=1
